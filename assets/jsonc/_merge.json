{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "JSON schema for JSONPatch files",
  "type": "array",
  "id": "https://json.schemastore.org/json-patch.json",
  "definitions": {
    "jsonPointer": {
      "description": "A JSON Pointer path.",
      "type": "string",
      "pattern": "^#?(|(/([^/~]|~[01])*)*)$"
    },
    "opAddReplaceTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path"],
      "properties": {
        "path": { "$ref": "#/definitions/jsonPointer" },
        "op": {
          "type": "string",
          "enum": ["add", "replace", "test"]
        },
        "value": {}
      },
      "allOf": [
        {
          "required": ["value"]
        }
      ]
    },
    "opRemove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path"],
      "properties": {
        "path": { "$ref": "#/definitions/jsonPointer" },
        "op": {
          "type": "string",
          "enum": ["remove"]
        }
      }
    },
    "opMoveCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path", "from"],
      "properties": {
        "path": { "$ref": "#/definitions/jsonPointer" },
        "op": {
          "type": "string",
          "enum": ["move", "copy"]
        },
        "from": { "$ref": "#/definitions/jsonPointer" }
      }
    }
  },
  "items": {
    "oneOf": [
      { "$ref": "#/definitions/opAddReplaceTest" },
      { "$ref": "#/definitions/opRemove" },
      { "$ref": "#/definitions/opMoveCopy" }
    ]
  }
}
